    "text": "from pathlib import Path\nfrom datetime import datetime,timezone\nimport json,sys\nb=Path('/media/user/Data/TimeLearnerRefactor');actor=b/'source-classic-predecessor-20261123-j1';sys.path.insert(0,str(actor));sys.dont_write_bytecode=True\nfrom Scripts.StructTrain.TimeLearner.contained_process import inspect\nfrom Scripts.StructTrain.TimeLearner.owned_native_job import _same_process\nfrom Scripts.StructTrain.TimeLearner.recognition_metrics import load_physical_model_data_evaluation\nfrom Scripts.StructTrain.TimeLearner.runtime import file_record\nresult=dict(observed_utc=datetime.now(timezone.utc).isoformat(),scientific_verdict=None,studies={})\nfor name in ('classic-count-predecessor-m40-j1','classic-count-long-predecessor-m40-k2'):\n o=b/'readbacks'/name;c=b/'requests'/name;spec=json.loads((c/'specification.json').read_bytes());cases={};summary=dict(supervisor_live=_same_process(json.loads((o/'owner.json').read_bytes())),state=json.loads((o/'state.json').read_bytes()),completed_cases=[],closed_case_count=0,controls=[],expected_control_comparisons=13)\n for n in ('exception.json','terminal.json'):\n  if(o/n).exists():summary[n]=json.loads((o/n).read_bytes())\n for case in spec['cases']:\n  leaf=o/case['id'];p=leaf/'measurement/terminal.json'\n  if not p.exists():continue\n  if not all(inspect(leaf/k)['all_processes_closed']for k in ('controller/process/contained','measurement/run/process/contained')):continue\n  t=json.loads(p.read_bytes());assert t['validity']=='valid'and t['frozen_model_verified']and t['complete_contiguous_observations_verified']\n  evaluation=leaf/'measurement/run/native/evaluation.json';before=file_record(evaluation);_,obs=load_physical_model_data_evaluation(evaluation);assert file_record(evaluation)==before and len(obs)==2\n  assert all(v['model_before']==spec['model_revision']==v['model_after']for v in obs)\n  cases[case['id']]=obs\n  target=obs[1];summary['completed_cases'].append(dict(id=case['id'],counts=t['counts'],model_revision=spec['model_revision'],threshold=spec['threshold'],complete=True,valid=True,stimulus_times=target['stimulus_times'],spike_times=target['spike_times'],events_before_target_last_input=[v for v in target['spike_times']if v<target['stimulus_times'][-1]-1e-12],terminal=file_record(p)))\n def compare(label,a,z):\n  condition=all(a[k]==z[k]for k in ('sample_id','pattern_hash','stimulus_times','reset_policy','model_before','model_after','threshold_potential_source'))\n  times=[s['time']for s in a['samples']]==[s['time']for s in z['samples']]\n  delta=None\n  if times:\n   ds=[]\n   for u,v in zip(a['samples'],z['samples']):\n    assert len(u['soma'])==len(v['soma'])\n    ds.extend(abs(x-y)for x,y in zip(u['soma'],v['soma']))\n    ds.extend(abs(u[k]-v[k])for k in ('lt_potential','lt_output','stimulus'))\n   delta=max(ds,default=0.)\n  summary['controls'].append(dict(comparison=label,actual_conditions_equal=condition,sample_times_equal=times,all_sample_fields_exact=a['samples']==z['samples'],maximum_abs_signal_difference=delta,spike_times_equal=a['spike_times']==z['spike_times'],stimulus_times_equal=a['stimulus_times']==z['stimulus_times']))\n for predecessor in sorted({x['predecessor']for x in spec['cases']}):\n  a=cases.get(predecessor+'-reset');z=cases.get(predecessor+'-preserve')\n  if a and z:compare('same first predecessor '+predecessor,a[0],z[0])\n targets=[(key,value[1])for key,value in cases.items()if key.endswith('-reset')]\n if targets:\n  key,a=targets[0]\n  for other,z in targets[1:]:compare('same reset target '+key+' vs '+other,a,z)\n summary['closed_case_count']=len(cases);summary['completed_control_comparisons']=len(summary['controls']);summary['all_observed_controls_exact']=(all(v['actual_conditions_equal']and v['all_sample_fields_exact']and v['spike_times_equal']for v in summary['controls'])if summary['controls']else None);summary['all14_cases_and13_controls_complete']=len(cases)==14 and len(summary['controls'])==13\n result['studies'][name]=summary\nprint(json.dumps(result))\n"
