# EditorConfig помогает поддерживать единообразный стиль кода
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,c,hpp,cc,cxx}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.{json,xml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
