# One Qt prefix, one major version; required modules must never be empty aliases.
include_guard(GLOBAL)
if(DEFINED QT_MAJOR AND NOT DEFINED QT_VERSION_MAJOR)
  set(QT_VERSION_MAJOR "${QT_MAJOR}")
endif()
if(NMSDK_QT_PROVIDER STREQUAL "vcpkg")
  if(NOT VCPKG_INSTALLED_DIR OR NOT VCPKG_TARGET_TRIPLET)
    message(FATAL_ERROR "vcpkg Qt requires the vcpkg toolchain and a target triplet")
  endif()
  set(_qt_prefix "${VCPKG_INSTALLED_DIR}/${VCPKG_TARGET_TRIPLET}")
  set(QT_VERSION_MAJOR 6)
  set(Qt6_DIR "${_qt_prefix}/share/Qt6" CACHE PATH "Selected vcpkg Qt" FORCE)
elseif(DEFINED ENV{QT_ROOT} AND NOT "$ENV{QT_ROOT}" STREQUAL "")
  file(TO_CMAKE_PATH "$ENV{QT_ROOT}" _qt_prefix)
  list(PREPEND CMAKE_PREFIX_PATH "${_qt_prefix}")
  if(NOT DEFINED QT_VERSION_MAJOR)
    if(EXISTS "${_qt_prefix}/lib/cmake/Qt6/Qt6Config.cmake")
      set(QT_VERSION_MAJOR 6)
    elseif(EXISTS "${_qt_prefix}/lib/cmake/Qt5/Qt5Config.cmake")
      set(QT_VERSION_MAJOR 5)
    else()
      message(FATAL_ERROR "QT_ROOT must contain lib/cmake/Qt5 or lib/cmake/Qt6")
    endif()
  endif()
  set(Qt${QT_VERSION_MAJOR}_DIR "${_qt_prefix}/lib/cmake/Qt${QT_VERSION_MAJOR}" CACHE PATH "Selected local Qt" FORCE)
endif()
if(NOT DEFINED QT_VERSION_MAJOR)
  find_package(QT NAMES Qt6 Qt5 REQUIRED COMPONENTS Core)
endif()
if(NOT QT_VERSION_MAJOR MATCHES "^[56]$")
  message(FATAL_ERROR "QT_VERSION_MAJOR must be 5 or 6")
endif()
set(_qt Qt${QT_VERSION_MAJOR})
set(_components Core Gui Widgets Network PrintSupport Sql Xml Concurrent Test SerialPort Charts Svg)
if(QT_VERSION_MAJOR EQUAL 6)
  list(APPEND _components Core5Compat SvgWidgets)
endif()
find_package(${_qt} REQUIRED COMPONENTS ${_components})
if(QT_VERSION_MAJOR EQUAL 5 AND Qt5Core_VERSION VERSION_LESS 5.15)
  message(FATAL_ERROR "Qt 5.15 or newer is required")
endif()
if(NMSDK_QT_PROVIDER STREQUAL "local" AND VCPKG_INSTALLED_DIR)
  get_target_property(_core_location ${_qt}::Core IMPORTED_LOCATION_RELEASE)
  if(_core_location)
    file(TO_CMAKE_PATH "${VCPKG_INSTALLED_DIR}" _vcpkg_prefix)
    string(FIND "${_core_location}" "${_vcpkg_prefix}/" _from_vcpkg)
    if(_from_vcpkg EQUAL 0)
      message(FATAL_ERROR "Local Qt preset resolved vcpkg Qt. Set QT_ROOT to a complete local installation.")
    endif()
  endif()
endif()
option(NMSDK_USE_WEBENGINE "Use Qt WebEngine when available (vcpkg requires webengine manifest feature)" OFF)
set(NMSDK_QT_WEBENGINE_AVAILABLE FALSE)
if(NMSDK_USE_WEBENGINE)
  find_package(${_qt} REQUIRED COMPONENTS WebEngineWidgets)
  set(NMSDK_QT_WEBENGINE_AVAILABLE TRUE)
endif()
foreach(_alias Core Gui Widgets Network Print Sql Xml Concurrent Test SerialPort Charts Svg WebEngineWidgets CoreCompat)
  set(_module ${_alias})
  if(_alias STREQUAL "Print")
    set(_module PrintSupport)
  elseif(_alias STREQUAL "CoreCompat")
    set(_module Core5Compat)
  endif()
  add_library(Nmsdk_Qt_${_alias} INTERFACE)
  add_library(Nmsdk::Qt::${_alias} ALIAS Nmsdk_Qt_${_alias})
  if(TARGET ${_qt}::${_module})
    target_link_libraries(Nmsdk_Qt_${_alias} INTERFACE ${_qt}::${_module})
  endif()
endforeach()
message(STATUS "Nmsdk: Qt${QT_VERSION_MAJOR} (${NMSDK_QT_PROVIDER}), WebEngine=${NMSDK_QT_WEBENGINE_AVAILABLE}")
