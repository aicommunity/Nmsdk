include(ProcessorCount)
ProcessorCount(_nmsdk_cores)
if(NOT _nmsdk_cores)
  set(_nmsdk_cores 4)
endif()
set(NMSDK_BUILD_PARALLEL_JOBS "${_nmsdk_cores}" CACHE STRING "Parallel compilation limit")
if(NOT "$ENV{CMAKE_BUILD_PARALLEL_LEVEL}" MATCHES "^[1-9][0-9]*$")
  set(ENV{CMAKE_BUILD_PARALLEL_LEVEL} "${NMSDK_BUILD_PARALLEL_JOBS}")
endif()
