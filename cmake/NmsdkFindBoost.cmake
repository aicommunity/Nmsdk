include_guard(GLOBAL)
# Recent Boost versions publish CMake targets directly and may make system
# header-only. Older distributions still support FindBoost's module mode.
set(_nmsdk_boost_components program_options thread filesystem chrono atomic)
find_package(Boost CONFIG QUIET COMPONENTS ${_nmsdk_boost_components})
if(NOT Boost_FOUND)
  if(POLICY CMP0167)
    cmake_policy(SET CMP0167 OLD)
  endif()
  find_package(Boost REQUIRED COMPONENTS ${_nmsdk_boost_components})
endif()
add_library(Nmsdk_Boost INTERFACE)
add_library(Nmsdk::Boost ALIAS Nmsdk_Boost)
foreach(_component IN LISTS _nmsdk_boost_components)
  target_link_libraries(Nmsdk_Boost INTERFACE Boost::${_component})
endforeach()
if(TARGET Boost::system)
  target_link_libraries(Nmsdk_Boost INTERFACE Boost::system)
endif()
