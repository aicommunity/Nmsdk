if(CONFIG STREQUAL "Debug")
  set(_bin "${DEBUG_BIN}")
else()
  set(_bin "${RELEASE_BIN}")
endif()
if(NOT IS_DIRECTORY "${_bin}")
  message(FATAL_ERROR "Missing ${CONFIG} vcpkg runtime directory: ${_bin}")
endif()
file(GLOB _dlls "${_bin}/*.dll")
foreach(_dll IN LISTS _dlls)
  get_filename_component(_name "${_dll}" NAME)
  # windeployqt handles Qt and plugins; vcpkg handles other runtime DLLs.
  if(NOT _name MATCHES "^Qt[56]")
    file(COPY_FILE "${_dll}" "${OUTPUT_DIR}/${_name}" ONLY_IF_DIFFERENT)
  endif()
endforeach()
