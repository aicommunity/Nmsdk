{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Selected CMake target (Windows)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${command:cmake.launchTargetDirectory}",
      "environment": [
        {
          "name": "NMSDK_ROOT",
          "value": "${workspaceFolder}"
        },
        {
          "name": "QT_PLUGIN_PATH",
          "value": ""
        }
      ],
      "args": [],
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Selected CMake target (Linux, gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "cwd": "${command:cmake.launchTargetDirectory}",
      "MIMode": "gdb",
      "args": [],
      "externalConsole": false
    }
  ]
}
