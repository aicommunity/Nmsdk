{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "nmsdk: configure (linux-gcc-debug-local)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "linux-gcc-debug-local",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false
      }
    },
    {
      "label": "nmsdk: build NeuroModeler",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-gcc-debug",
        "--target",
        "NeuroModeler",
        "--parallel"
      ],
      "windows": {
        "args": [
          "--build",
          "--preset",
          "win-vs2019-release-localqt",
          "--target",
          "NeuroModeler",
          "--parallel"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc", "$msCompile"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "nmsdk: build NeuroModeler (linux-gcc-debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-gcc-debug",
        "--target",
        "NeuroModeler",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "nmsdk: configure+build NeuroModeler",
      "dependsOrder": "sequence",
      "dependsOn": [
        "nmsdk: configure (linux-gcc-debug-local)",
        "nmsdk: build NeuroModeler (linux-gcc-debug)"
      ],
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "nmsdk: build all (linux-gcc-debug)",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-gcc-debug",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "nmsdk: build NeuroModelerConsole",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-gcc-debug",
        "--target",
        "NeuroModelerConsole",
        "--parallel"
      ],
      "windows": {
        "args": [
          "--build",
          "--preset",
          "win-vs2019-release-localqt",
          "--target",
          "NeuroModelerConsole",
          "--parallel"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc", "$msCompile"]
    },
    {
      "label": "nmsdk: run NeuroModeler",
      "type": "shell",
      "command": "${workspaceFolder}/Bin/Platform/Linux/NeuroModeler",
      "windows": {
        "command": "${workspaceFolder}/Bin/Platform/Win/NeuroModeler.exe",
        "options": {
          "cwd": "${workspaceFolder}/Bin/Platform/Win",
          "env": {
            "NMSDK_ROOT": "${workspaceFolder}",
            "NMSDK_SOURCE_DIR": "${workspaceFolder}",
            "VCPKG_ROOT": "${env:VCPKG_ROOT}"
          }
        }
      },
      "options": {
        "cwd": "${workspaceFolder}/Bin/Platform/Linux",
        "env": {
          "NMSDK_ROOT": "${workspaceFolder}",
          "NMSDK_SOURCE_DIR": "${workspaceFolder}"
        }
      },
      // No dependsOn build: avoids a second full rebuild after CMake Build/Launch.
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "CMake: build (platform preset)",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-gcc-debug",
        "--target",
        "NeuroModeler",
        "--parallel"
      ],
      "windows": {
        "args": [
          "--build",
          "--preset",
          "win-vs2019-release-localqt",
          "--target",
          "NeuroModeler",
          "--parallel"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc", "$msCompile"]
    }
  ]
}
