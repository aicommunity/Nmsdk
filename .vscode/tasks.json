{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: build (platform preset)",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "linux-gcc-debug",
        "--parallel"
      ],
      "windows": {
        "args": [
          "--build",
          "--preset",
          "win-vs2022-debug",
          "--parallel"
        ]
      },
      "group": "build",
      "problemMatcher": "$msCompile"
    }
  ]
}

