{
  "name": "nmsdk",
  "version-string": "0.1.0",
  "dependencies": [
    {
      "name": "curl"
    },
    {
      "name": "opencv",
      "default-features": true
    },
    {
      "name": "python3"
    },
    {
      "name": "eigen3"
    },
    {
      "name": "zlib"
    },
    { "name": "boost-program-options" },
    { "name": "boost-thread" },
    { "name": "boost-filesystem" },
    { "name": "boost-system" },
    { "name": "boost-chrono" },
    { "name": "boost-atomic" },
    { "name": "glog" }
  ],
  "features": {
    "qt": {
      "description": "Enable Qt GUI via vcpkg (Qt6: qtbase, qttools, qtserialport, qtcharts, qtwebengine)",
      "dependencies": [
        "qtbase",
        "qttools",
        "qtserialport",
        "qtcharts",
        "qtwebengine"
      ]
    },
    "python": {
      "description": "Enable Python",
      "dependencies": [
        "python3"
      ]
    },
    "darknet": {
      "description": "Enable Darknet",
      "dependencies": []
    },
    "tensorflow": {
      "description": "Enable TensorFlow",
      "dependencies": []
    }
  }
}
