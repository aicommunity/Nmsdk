digraph G {
graph [rankdir=TB,bgcolor="white",pad=0.08,nodesep=0.22,ranksep=0.2,label="Общая ветвь при M=4",labelloc=t,fontname="Times New Roman",fontsize=22];
node [fontname="Times New Roman",fontsize=22,shape=box,margin="0.08,0.04"];
edge [arrowsize=0.75];
u0 [label="Пачка → вход 0\nNₛ,₀ и Rₛ,₀"];u1 [label="Пачка → вход 1\nNₛ,₁ и Rₛ,₁"];
u2 [label="Пачка → вход 2\nNₛ,₂ и Rₛ,₂"];u3 [label="Пачка → вход 3\nNₛ,₃ и Rₛ,₃"];
p0 [label="L₀",shape=circle];p1 [label="L₁",shape=circle];p2 [label="L₂",shape=circle];p3 [label="L₃",shape=circle];
{rank=same;u0;p0} {rank=same;u1;p1} {rank=same;u2;p2} {rank=same;u3;p3}
u0->p0;u1->p1;u2->p2;u3->p3;p0->p1->p2->p3;
soma [label="Сома"];
lt [label="Низкопороговая зона\nи выходные события"];
p3->soma->lt; lt->soma [style=dashed,constraint=false];
u0->u1->u2->u3 [style=invis];
}