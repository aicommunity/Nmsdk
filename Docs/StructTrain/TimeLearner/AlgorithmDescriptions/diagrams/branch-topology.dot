digraph G {
 graph [rankdir=TB, bgcolor=white, pad="0.15", nodesep="0.25", ranksep="0.28", fontname=Arial];
 node [shape=box, style=rounded, fontname=Arial, fontsize=18, margin="0.12,0.09"];
 edge [fontname=Arial, fontsize=15, arrowsize=0.8];
 x [label="Входная\nпачка x(t)"];
 s0 [label="Синапсы\nвхода 0"];
 s1 [label="Синапсы\nвхода 1"];
 sr [label="Опорные\nсинапсы"];
 p0 [label="Дальняя точка\nL₀"];
 p1 [label="Точка L₁"];
 pr [label="Опорная\nточка Lᵣ"];
 b [label="Сома"];
 z [label="Низкопороговая\nзона"];
 y [label="Выходной\nимпульс"];
 x -> s0 -> p0;
 x -> s1 -> p1;
 x -> sr -> pr;
 p0 -> p1 [penwidth=2.4, label="общий кабель"];
 p1 -> pr [penwidth=2.4];
 pr -> b -> z -> y;
 z -> b [style=dashed, constraint=false, label="перезарядка"];
}
