digraph G {
 graph [rankdir=TB, bgcolor=white, pad="0.12", ranksep="0.34", nodesep="0.4"];
 node [shape=box, fontname=Arial, fontsize=18, margin="0.14,0.09"];
 edge [fontname=Arial, fontsize=15, arrowsize=0.8];
 initial [shape=oval, label="Цель Aᵢ⁽⁰⁾ и допустимая геометрия"];
 candidate [label="Выбрать ещё не измеренное\nцелое число синапсов Nₛ,ᵢ"];
 build [label="Построить реальный набор синапсов\nПроверить граф и ограничения"];
 measure [label="Измерить закреплённый отклик\nи требуемые повторы"];
 valid [shape=diamond, label="Измерение\nдостоверно?"];
 compare [label="Сравнить ошибки времени и амплитуды\nСохранить измеренную точку"];
 ready [shape=diamond, label="Оба допуска\nвыполнены?"];
 next [label="Следующий допустимый Nₛ,ᵢ\nили другая геометрия в пределах бюджета"];
 invalid [shape=diamond, label="Политика допускает\nновую пробу?"];
 end [shape=oval, label="Локальный результат\nЗатем общая свежая проверка"];
 initial -> candidate -> build -> measure -> valid;
 valid -> compare [label="да"];
 valid -> invalid [label="нет"];
 compare -> ready;
 ready -> end [label="да"];
 ready -> next [label="нет"];
 next -> candidate [constraint=false, label="есть бюджет"];
 next -> end [label="бюджет исчерпан"];
 invalid -> candidate [label="да", constraint=false];
 invalid -> end [label="нет"];
}
