digraph Pattern {
 graph [bgcolor="white",pad=0.15,notranslate=true,overlap=true,splines=line,
   fontname="Times New Roman",fontsize=22,label="Временной паттерн при M = 4",labelloc=t];
 node [shape=point,width=0.025,height=0.025,label="",pin=true];
 edge [arrowsize=0.8,penwidth=1.5];
 b1 [pos="0,0!"];b2 [pos="1.6,0!"];b3 [pos="4.8,0!"];b4 [pos="9.6,0!"];
 p1 [pos="0,0.8!"];p2 [pos="1.6,0.8!"];p3 [pos="4.8,0.8!"];p4 [pos="9.6,0.8!"];
 b1->b2->b3->b4 [dir=none];b1->p1;b2->p2;b3->p3;b4->p4;
 node [shape=plaintext,width=0,height=0,fontname="Times New Roman",fontsize=20];
 t1 [pos="0,-0.5!",label="0 мс\nИмпульс 1"];
 t2 [pos="1.6,-0.5!",label="80 мс\nИмпульс 2"];
 t3 [pos="4.8,-0.5!",label="240 мс\nИмпульс 3"];
 t4 [pos="9.6,-0.5!",label="480 мс\nИмпульс 4"];
 d1 [pos="0.8,1.1!",label="80 мс"];
 d2 [pos="3.2,1.1!",label="160 мс"];
 d3 [pos="7.2,1.1!",label="240 мс"];
}
