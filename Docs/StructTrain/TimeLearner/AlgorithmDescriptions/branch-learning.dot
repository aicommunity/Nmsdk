digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.08, nodesep=0.22, ranksep=0.28];
node [fontname="Times New Roman", fontsize=22, shape=box, margin="0.08,0.04"];
edge [fontname="Times New Roman", fontsize=18, arrowsize=0.8];
a [label="Общая ветвь и паттерн\nСобственные цели Aᵢ⁽⁰⁾",shape=ellipse];
b [label="Опорный вход r=M−1"];
c [label="Вход в обратном порядке\nДопустимые точки подключения"];
d [label="Изменить общий участок\nснять затронутые подтверждения"];
e [label="Завершить пробу\nизмерить время и амплитуду"];
f [label="Локальные\nдопуски?",shape=diamond];
n [label="Сохранить локальный результат\nВыбрать следующий вход"];
g [label="Разрешён шаг\nи остался бюджет?",shape=diamond];
h [label="Свежая проверка всех входов\nна конечной общей ветви"];
z [label="Модель и явный исход",shape=ellipse];
a->b->c->d->e->f;f->n [label="да"];n->c [label="есть вход"];n->h [label="конец обхода"];
f->g [label="нет"];e->g [label="недостоверно",constraint=false];g->c [label="да"];g->z [label="нет"];h->z;
}